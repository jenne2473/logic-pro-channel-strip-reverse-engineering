{
  "project": {
    "name": "Logic Pro Channel Strip Reverse Engineering",
    "version": "0.2.0",
    "status": "experimental",
    "purpose": "Document and automate parameter editing in Logic Pro .cst Channel Strip Setting files.",
    "workflow": "Use a compatible reference/template CST and modify embedded plugin state; do not assume complete CST generation from scratch is supported.",
    "compatibility_warning": "Offsets and state layout are empirical and may change with Logic Pro, plugin, or plugin-version updates."
  },
  "plugins": {
    "uadx_dbx_160": {
      "display_name": "UADx dbx 160",
      "manufacturer": "Universal Audio",
      "state_container": "jucePluginState",
      "state_encoding": "base64",
      "decoded_value_type": "float32_le",
      "repetition_count": 32,
      "stride_bytes": 68,
      "template_offsets": {
        "threshold": 209,
        "compression": 213,
        "output_gain": 217,
        "mix": 229
      },
      "parameters": {
        "threshold": {
          "normalized_range": [
            0.0,
            1.0
          ],
          "mapping": "normalized knob position",
          "observations": {
            "minimum": 0.0,
            "middle": 0.5,
            "maximum": 1.0
          }
        },
        "compression": {
          "normalized_range": [
            0.0,
            1.0
          ],
          "mapping": "normalized internal parameter; visible scale is non-linear",
          "observations": {
            "visible_1": 0.0,
            "visible_4": 0.5,
            "maximum": 1.0,
            "approx_visible_3": 0.359985,
            "approx_visible_6": 0.669983
          }
        },
        "output_gain": {
          "normalized_range": [
            0.0,
            1.0
          ],
          "visible_range_db": [
            -20.0,
            20.0
          ],
          "formula_from_normalized": "dB = 40*x - 20",
          "formula_to_normalized": "x = (dB + 20) / 40",
          "observations": {
            "-20_dB": 0.0,
            "0_dB": 0.5,
            "+20_dB": 1.0
          }
        },
        "mix": {
          "normalized_range": [
            0.0,
            1.0
          ],
          "visible_range_percent": [
            0.0,
            100.0
          ],
          "formula_from_normalized": "percent = 100*x",
          "formula_to_normalized": "x = percent / 100",
          "observations": {
            "minimum": 0.0,
            "near_middle_mouse_position": 0.47998046875,
            "maximum": 1.0
          }
        }
      },
      "validated_generated_test": {
        "threshold": 0.5,
        "compression": 0.5,
        "output_gain": 0.75,
        "output_gain_db": 10.0,
        "mix": 0.25,
        "result": "Successfully loaded in Logic Pro; all four controls displayed as expected."
      },
      "reference_template": {
        "path": "reference/UADx_dbx160_reference.cst",
        "known_values": {
          "threshold_normalized": 0.5,
          "compression_normalized": 0.5,
          "compression_visible": 4,
          "output_gain_db": 0.0,
          "mix_percent": 100.0
        },
        "intended_use": "Canonical minimal dbx-only CST template for future automated edits."
      }
    }
  }
}